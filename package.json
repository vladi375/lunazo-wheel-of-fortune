{
    "name": "lunazo-wheel-of-fortune",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:wheel-v1-co": "vite --mode wheel-v1-co --port 5101",
        "dev:wheel-v1-ar": "vite --mode wheel-v1-ar --port 5102",
        "dev:wheel-v2-co": "vite --mode wheel-v2-co --port 5103",
        "dev:wheel-v2-ar": "vite --mode wheel-v2-ar --port 5104",
        "build": "tsc --noEmit && vite build",
        "build:sites": "npm run build && node tools/build-sites.mjs",
        "build:gitlab": "tsc --noEmit && vite build --mode gitlab && node tools/build-gitlab.mjs && node --test checks/gitlab-deploy.mjs",
        "preview": "vite preview",
        "preview:wheel-v1-co": "vite preview --outDir deploy/wheel-v1-co --port 5101",
        "preview:wheel-v1-ar": "vite preview --outDir deploy/wheel-v1-ar --port 5102",
        "preview:wheel-v2-co": "vite preview --outDir deploy/wheel-v2-co --port 5103",
        "preview:wheel-v2-ar": "vite preview --outDir deploy/wheel-v2-ar --port 5104",
        "test": "node --test checks/links.mjs",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=22.18"
    },
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0"
    }
}
