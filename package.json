{
    "name": "lunazo-wheel-of-fortune",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:wheel-v1": "vite --mode wheel-v1 --port 5101",
        "dev:wheel-v2": "vite --mode wheel-v2 --port 5102",
        "build": "tsc --noEmit && vite build",
        "build:sites": "npm run build && node tools/build-sites.mjs",
        "preview": "vite preview",
        "preview:wheel-v1": "vite preview --outDir deploy/wheel-v1 --port 5101",
        "preview:wheel-v2": "vite preview --outDir deploy/wheel-v2 --port 5102",
        "test": "node --test checks/*.mjs",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=22.18"
    },
    "dependencies": {
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "typescript": "^7.0.2",
        "vite": "^8.3.0"
    }
}
